# Copy to .env for local runs (git-ignored). On Vercel, set these in Project Settings.
# Gemini API key from https://aistudio.google.com (free tier; do not attach billing to stay at ₱0)
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional model chain, tried in order when a model is overloaded (503) or out of free quota (429).
# Overrides GEMINI_MODEL. Leave unset to use the built-in 11-model chain:
# gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-flash-lite-latest,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_MODELS=
# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY (public, safe)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated web origins allowed by CORS (mobile does not need CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://bucktbt-dev.vercel.app
